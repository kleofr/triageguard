# ==============================================================================
# TriageGuard Environment Configuration Template
# Copy this file to .env and customize with your credentials:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Settings
# ------------------------------------------------------------------------------
APP_ENV=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 2. Supabase Database Configuration
# ------------------------------------------------------------------------------
# Supabase project URL (found in Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon / Publishable Key (safe for client queries with RLS)
SUPABASE_KEY=your-supabase-anon-or-service-key

# Optional: Supabase Service Role Key (bypasses RLS for secure backend admin operations)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Direct PostgreSQL Database Connection String
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Enable / Disable database persistence (true / false)
SUPABASE_ENABLED=true

# Database table names
SUPABASE_TABLE_TICKETS=tickets
SUPABASE_TABLE_SANITIZATION_LOGS=sanitization_logs

# ------------------------------------------------------------------------------
# 3. ML Model Caches & Execution Modes
# ------------------------------------------------------------------------------
# Directory for HuggingFace model cache (Llama Prompt Guard 2-86M)
HF_HOME=models/huggingface

# HuggingFace token for gated model downloads (optional if downloaded locally)
HF_TOKEN=

# Force mock mode for fast unit tests or resource-constrained environments (true / false)
PROMPT_GUARD_MOCK=false
ROUTER_MOCK=false

# ------------------------------------------------------------------------------
# 4. Routing Confidence Thresholds
# ------------------------------------------------------------------------------
CONF_CATEGORY_MIN=0.80
CONF_URGENCY_MIN=0.75

# ------------------------------------------------------------------------------
# 5. LLM Provider (OpenRouter only)
# ------------------------------------------------------------------------------
LLM_PROVIDER=openrouter
LLM_TIMEOUT_S=20

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1




# ------------------------------------------------------------------------------
# 6. Observability & Tracing (MLSecOps)
# ------------------------------------------------------------------------------
# OTLP collector endpoint (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
